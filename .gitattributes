# Normalize line endings based on file type.
# Text files are committed with LF. Windows batch files keep CRLF.

* text=auto

# Source and documentation files -> LF
*.py      text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.editorconfig text eol=lf

# Windows batch files -> CRLF (required for cmd.exe)
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files must never be normalized
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.svg     text eol=lf
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.exe     binary
*.msi     binary
*.zip     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary